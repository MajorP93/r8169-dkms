#!/bin/sh
set -e

# r8169 is normally part of the initramfs (initramfs-tools, MODULES=most), so
# the copy in there is what gets loaded at boot. DKMS does not regenerate
# existing initramfs images, so do it for every kernel that now has the DKMS
# module. Kernels installed later need nothing extra: their postinst hooks
# run DKMS before update-initramfs. On Proxmox VE, update-initramfs also
# triggers the proxmox-boot-tool ESP sync.

r8169_dkms_kernels() {
	for mod in /lib/modules/*/updates/dkms/r8169.ko*; do
		[ -e "$mod" ] || continue
		kver=${mod#/lib/modules/}
		echo "${kver%%/*}"
	done
}

refresh_initramfs() {
	command -v update-initramfs >/dev/null 2>&1 || return 0
	for kver in "$@"; do
		[ -e "/boot/initrd.img-$kver" ] || continue
		update-initramfs -u -k "$kver" ||
			echo "r8169-dkms: failed to update the initramfs for $kver" >&2
	done
}

#DEBHELPER#

case "$1" in
	configure)
		refresh_initramfs $(r8169_dkms_kernels)
		;;
esac

exit 0
